rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    function isModerator() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "moderator";
    }
    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified;
    }
    function isNotBlocked() {
      return !exists(/databases/$(database)/documents/denylist/$(request.auth.uid));
    }

    // DRAFTS — only the author and moderators
    // Titles may be a plain string or a [lead, highlight] tuple (list).
    function hasValidTitle() {
      return request.resource.data.title is string
             || request.resource.data.title is list;
    }

    match /drafts/{draftId} {
      allow read: if isOwner(resource.data.authorId) || isModerator();
      allow create: if isSignedIn()
                    && request.resource.data.authorId == request.auth.uid
                    && hasValidTitle()
                    && request.resource.data.content is string;
      allow update: if isOwner(resource.data.authorId)
                    && request.resource.data.authorId == resource.data.authorId;
      allow delete: if isOwner(resource.data.authorId) || isModerator();
    }

    // PUBLISHED — anyone can read. Client-only publishing: a signed-in author
    // may create/update their OWN published post (moderators, any post).
    match /published/{postId} {
      allow read: if true;
      allow create: if isSignedIn()
                    && request.resource.data.authorId == request.auth.uid
                    && hasValidTitle()
                    && request.resource.data.content is string;
      allow update: if isModerator()
                    || (isOwner(resource.data.authorId)
                        && request.resource.data.authorId == resource.data.authorId);
      allow delete: if isOwner(resource.data.authorId) || isModerator();

      // COMMENTS — subcollection on each published post
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isVerified() && isNotBlocked()
                      && request.resource.data.authorId == request.auth.uid
                      && request.resource.data.content is string;
        allow update: if isOwner(resource.data.authorId)
                      && (request.time - resource.data.createdAt) < duration.value(1, 'h');
        allow delete: if isOwner(resource.data.authorId)
                      || isModerator()
                      || isOwner(get(/databases/$(database)/documents/published/$(postId)).data.authorId);
      }
    }

    // USERS
    match /users/{userId} {
      allow read: if true;
      allow write: if isOwner(userId);
    }

    // SUBSCRIBERS — newsletter signups. Anyone may subscribe (create their own
    // doc keyed by email); the list is never client-readable. Moderators can
    // clean up entries.
    match /subscribers/{email} {
      allow read: if false;
      allow create: if request.resource.data.email is string
                    && request.resource.data.email == email;
      allow update: if false;
      allow delete: if isModerator();
    }
  }
}