rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Identity helpers ──────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Roles. Three tiers, stored on users/{uid}.role:
    //   reader    — the default; reads posts and writes comments
    //   editor    — reader + writes and publishes their OWN posts
    //   moderator — editor + deletes ANY post or comment
    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isModerator() {
      return isSignedIn() && role() == "moderator";
    }
    // May author posts: editors and moderators.
    function canWrite() {
      return isSignedIn() && (role() == "editor" || role() == "moderator");
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified;
    }
    function isNotBlocked() {
      return !exists(/databases/$(database)/documents/denylist/$(request.auth.uid));
    }

    // Titles may be a plain string or a [lead, highlight] tuple (list).
    // Size limits live HERE, not only in the forms: the web config ships to
    // every browser, so anyone can write to this database with the SDK and
    // never see a React validator. A Firestore document is capped at ~1 MiB,
    // which without these is the only limit that applies.
    function hasValidTitle() {
      return (request.resource.data.title is string
              && request.resource.data.title.size() <= 300)
             || (request.resource.data.title is list
                 && request.resource.data.title.size() <= 2);
    }

    // Content is either legacy markdown-ish text (the seeded essays) or a
    // TipTap JSON document (everything written in the editor).
    function hasValidContent() {
      return (request.resource.data.content is string
              && request.resource.data.content.size() <= 200000)
             || request.resource.data.content is map;
    }

    // Excerpts feed the cards and the link previews; nothing needs more.
    function hasValidExcerpt() {
      return !('excerpt' in request.resource.data.keys())
             || (request.resource.data.excerpt is string
                 && request.resource.data.excerpt.size() <= 1000);
    }

    // ── DRAFTS — the author and moderators ────────────────────────────────
    match /drafts/{draftId} {
      allow read: if isOwner(resource.data.authorId) || isModerator();
      allow create: if canWrite()
                    && request.resource.data.authorId == request.auth.uid
                    && hasValidTitle()
                    && hasValidContent()
                    && hasValidExcerpt();
      allow update: if isOwner(resource.data.authorId)
                    && canWrite()
                    && request.resource.data.authorId == resource.data.authorId
                    && hasValidContent()
                    && hasValidExcerpt();
      allow delete: if isOwner(resource.data.authorId) || isModerator();
    }

    // ── PUBLISHED — world readable; authored by editors ───────────────────
    match /published/{postId} {
      allow read: if true;
      allow create: if canWrite()
                    && request.resource.data.authorId == request.auth.uid
                    && hasValidTitle()
                    && hasValidContent()
                    && hasValidExcerpt();
      // An editor may revise only their own post; a moderator, any post.
      allow update: if isModerator()
                    || (isOwner(resource.data.authorId)
                        && canWrite()
                        && request.resource.data.authorId == resource.data.authorId
                        && hasValidContent()
                    && hasValidExcerpt());
      allow delete: if isOwner(resource.data.authorId) || isModerator();

      // ── COMMENTS — any verified member may join the discussion ──────────
      // Deliberately NOT gated on canWrite(): readers comment, they just
      // cannot author posts.
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isVerified() && isNotBlocked()
                      && request.resource.data.authorId == request.auth.uid
                      && request.resource.data.content is string
                      && request.resource.data.content.size() > 0
                      && request.resource.data.content.size() <= 2000;
        allow update: if isOwner(resource.data.authorId)
                      && request.resource.data.content is string
                      && request.resource.data.content.size() > 0
                      && request.resource.data.content.size() <= 2000
                      && (request.time - resource.data.createdAt) < duration.value(1, 'h');
        allow delete: if isOwner(resource.data.authorId)
                      || isModerator()
                      || isOwner(get(/databases/$(database)/documents/published/$(postId)).data.authorId);
      }
    }

    // ── USERS ─────────────────────────────────────────────────────────────
    // Publicly readable (bylines), but a member may never grant themselves a
    // role: every account is created as "reader", and an update must leave
    // `role` exactly as it was. Promotion to editor/moderator is done from
    // the Firebase console, which uses the Admin SDK and bypasses these rules.
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId)
                    && request.resource.data.role == "reader";
      allow update: if isOwner(userId)
                    && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    // USERNAMES — unique handle registry. Doc id = the username; value = { uid }.
    // Create-only claim: a signed-in user may claim a free name for themselves.
    // Existing docs can't be overwritten (that's what enforces uniqueness).
    match /usernames/{username} {
      allow read: if true;
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if isModerator();
    }

    // SUBSCRIBERS — newsletter signups. Anyone may subscribe (create their own
    // doc keyed by email); the list is never client-readable. Moderators can
    // clean up entries.
    match /subscribers/{email} {
      allow read: if false;
      allow create: if request.resource.data.email is string
                    && request.resource.data.email == email;
      allow update: if false;
      allow delete: if isModerator();
    }
  }
}
