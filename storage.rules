rules_version = '2';

// The Turing Circle — Storage rules.
//
// The read-only journal (v1) does not upload anything, so there is no
// catch-all rule: any path not matched below is denied by default. The
// `covers/` and `avatars/` rules are kept ready for the editor / profile
// work in a later phase (cover images and user avatars).
service firebase.storage {
  match /b/{bucket}/o {

    // Post cover images.
    //
    // Covers are pasted URLs today — nothing in the app uploads here. While
    // that is true this path stays shut: left open it accepted a 5MB file
    // from any signed-in account, under a name anyone could overwrite,
    // serving no feature. When uploads ship, re-open it scoped to the
    // owner's uid the way avatars/ already is.
    match /covers/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    // Per-user avatars — world-readable, written only by their owner.
    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 2 * 1024 * 1024  // max 2MB
                   && request.resource.contentType.matches('image/.*');
    }

  }
}
